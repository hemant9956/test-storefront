# Medusa backend
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_2db1043254fe8b5bc8064f3aec6bc34d82039587a2d31cc3c76fc9cd498fb2df
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# When DB stores localhost:9000 but backend runs on another port (e.g. Docker 9001), set:
# FILE_LOCAL_BACKEND_URL=http://localhost:9001
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=in

# Extra next/image hostnames (comma-separated). localhost and MEDUSA_BACKEND_URL are added automatically.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.example.com

# Analytics (Google Tag Manager) — set per environment, not in storefront.config.json
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Branding (shown in nav, hero fallbacks, promo bar)
# NEXT_PUBLIC_SHOP_NAME=My Shop
# NEXT_PUBLIC_HOME_PAGE_TITLE=Welcome to our store
# NEXT_PUBLIC_HOME_PAGE_DESCRIPTION=

# Payments
# Cashfree mode for storefront checkout modal (must match backend CASHFREE_ENVIRONMENT)
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=sandbox
# Razorpay public key (same value as backend RAZORPAY_KEY_ID)
# NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxx
# Force gateway when both are enabled: cashfree | razorpay
# NEXT_PUBLIC_PAYMENT_PROVIDER=razorpay

# Google OAuth — client ID must match backend GOOGLE_CLIENT_ID
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Callback must match a URI registered in Google Cloud Console (include region prefix when using country routes)
# NEXT_PUBLIC_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/in/auth/customer/google/callback

# Firebase Cloud Messaging (push notifications)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
