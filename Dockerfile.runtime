# Runtime-only image — built from host-prebuilt .generated-app (see scripts/docker-build-storefront.sh).
# No BuildKit/buildx features — classic `docker build` works on Ubuntu Engine.
FROM node:24-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips42 \
    libheif1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8000

COPY package.json next.config.js image-remote-patterns.js ./
COPY .next ./.next
COPY public ./public
COPY node_modules ./node_modules

EXPOSE 8000

CMD ["npm", "run", "start"]
